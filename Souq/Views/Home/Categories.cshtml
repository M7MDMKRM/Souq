@model IEnumerable<Souq.Models.Category>

@{
    ViewData["Title"] = "Shop by Category";
}

<!-- Premium Hero Header -->
<div class="pt-5 pb-5" style="background: linear-gradient(135deg, #5b21b6 0%, #310d6b 100%);">
    <div class="container pt-5 mt-5 text-center animate-fade-up">
        <h1 class="fw-bold text-white mb-2"><i class="bi bi-grid-3x3-gap me-2"></i>Discover Categories</h1>
        <p class="text-white-50">Find exactly what you're looking for by browsing our diverse collections</p>
    </div>
</div>

<div class="bg-theme-light py-5 min-vh-100">
    <div class="container">
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 animate-fade-up">
                        <div class="bg-white rounded-4 shadow-sm h-100 overflow-hidden transition-hover position-relative border-0">
                            <!-- Image Wrap -->
                            <div class="position-relative" style="height: 220px;">
                                @if (!string.IsNullOrEmpty(item.Photo))
                                {
                                    <img src="@item.Photo" class="w-100 h-100 object-fit-cover" alt="@item.Name">
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light">
                                        <i class="bi bi-tag display-1 text-muted opacity-25"></i>
                                    </div>
                                }
                                <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
                                    <h4 class="text-white fw-bold mb-0">@item.Name</h4>
                                </div>
                            </div>
                            
                            <!-- Content -->
                            <div class="p-4">
                                <p class="text-muted small mb-4" style="height: 45px; overflow: hidden;">@item.Description</p>
                                <a asp-controller="Products" asp-action="Index" asp-route-catId="@item.Id" class="btn btn-outline-primary rounded-pill w-100 fw-bold py-2" style="border-color: #5b21b6; color: #5b21b6;">
                                    Browse Products <i class="bi bi-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-grid display-1 text-muted opacity-25"></i>
                    <h4 class="mt-4">No categories found</h4>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .transition-hover:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(91, 33, 182, 0.15) !important;
    }
    .animate-fade-up {
        animation: fadeUp 0.6s ease-out forwards;
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>