                        </div>
                    </div>
                    <div class="col-6">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <i class="bi bi-check-circle-fill" style="color:#5b21b6;;font-size:18px;"></i>
                            <span style="font-weight:600;color:#333;">Secure Payment</span>
