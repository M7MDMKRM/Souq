    </div>
</section><!-- /About Section -->

<!-- Featured Products Section -->
<section id="portfolio" class="portfolio section">
    <div class="container section-title" data-aos="fade-up">
        <h2>Featured Products</h2>
        <p>Handpicked deals and top-selling items just for you</p>
    </div>
    <div class="container">
        <div class="row gy-4">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                        <div class="product-card">
                            <div class="card-img-wrap">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id">
                                    <img src="@item.Photo"
                                         style="width:100%;height:250px;object-fit:contain;padding:20px; transition: transform 0.5s ease;"
                                         onmouseover="this.style.transform='rotate(15deg) scale(1.1)'"
                                         onmouseout="this.style.transform='rotate(0deg) scale(1)'"
                                         alt="@item.Name">
                                </a>
                            </div>
                            <div class="card-body">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                    <h5 class="card-title">@item.Name</h5>
                                </a>
                                <p class="card-text text-muted" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 45px;">
                                    @item.Description
                                </p>
                                <div class="d-flex align-items-center justify-content-between mb-4">
                                    <span class="price-tag">EGP @item.Price</span>
                                    <div style="color:#f5a623;">
                                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                                    </div>
                                </div>
                                <div class="card-actions">
                                    <form asp-controller="Home" asp-action="AddToCart" method="post" class="flex-grow-1">
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <button type="submit" class="btn-cart-modern w-100 border-0"><i class="bi bi-cart-plus me-1"></i>Add to Cart</button>
                                    </form>
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn-details-modern"><i class="bi bi-eye"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">No featured products available at the moment.</p>
                </div>
            }

            <div class="text-center mt-5" data-aos="fade-up" style="width: 100%;">
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold shadow-lg transition-hover" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%); border: none;">
                    View All Products <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</section>
