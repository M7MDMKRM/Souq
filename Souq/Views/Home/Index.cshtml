    </div>
</section><!-- /About Section -->
<!-- Featured Products Section -->
<section id="portfolio" class="portfolio section">
    <div class="container section-title" data-aos="fade-up">
        <h2>Featured Products</h2>
        <p>Handpicked deals and top-selling items just for you</p>
    </div>
    <div class="container">
        <div class="row gy-4">

            @* Product Card 1 *@
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="product-card">
                    <div class="card-img-wrap">
                        <img src="~/assets/img/headphones1.png"
                             style="width:150%;height:250px;object-fit:contain;padding:20px;
                        transition: transform 0.5s ease;"
                             onmouseover="this.style.transform='rotate(15deg) scale(1.1)'"
                             onmouseout="this.style.transform='rotate(0deg) scale(1)'"
                             alt="Headphones">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Premium Wireless Headphones</h5>
                        <p class="card-text">Experience crystal-clear audio with our premium wireless headphones featuring active noise cancellation, 30-hour battery life, and ultra-soft ear cushions for all-day comfort. Perfect for music, calls, and everything in between.</p>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="price-tag">$89.99</span>
                            <div style="color:#f5a623;">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                            </div>
                        </div>
                        <div class="card-actions">
                            <a asp-controller="Home" asp-action="Cart" class="btn-cart"><i class="bi bi-cart-plus me-1"></i>Add to Cart</a>
                            <a asp-controller="Products" asp-action="Index" class="btn-details"><i class="bi bi-eye"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            @* Product Card 2 *@
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="product-card">
                    <div class="card-img-wrap">
                        <img src="~/assets/img/Smart watch.png"
                             style="width:150%;height:250px;object-fit:contain;padding:20px;
             transition: transform 0.5s ease;"
                             onmouseover="this.style.transform='rotate(15deg) scale(1.1)'"
                             onmouseout="this.style.transform='rotate(0deg) scale(1)'"
                             alt="Smart Fitness Watch">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Smart Fitness Watch</h5>
                        <p class="card-text">Stay on top of your health with our advanced fitness watch that tracks heart rate, steps, sleep, and workouts in real time. Features a sleek design, long battery life, and seamless smartphone notifications on your wrist.</p>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="price-tag">$66.50</span>
                            <div style="color:#f5a623;">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                            </div>
                        </div>
                        <div class="card-actions">
                            <a asp-controller="Home" asp-action="Cart" class="btn-cart"><i class="bi bi-cart-plus me-1"></i>Add to Cart</a>
                            <a asp-controller="Products" asp-action="Index" class="btn-details"><i class="bi bi-eye"></i></a>
                        </div>
                    </div>
                </div>
            </div>


            @* Product Card 3 *@
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="product-card">
                    <div class="card-img-wrap">
                        <img src="~/assets/img/Classic Canvas Duffle Bag.png"
                             style="width:150%;height:250px;object-fit:contain;padding:20px;
             transition: transform 0.5s ease;"
