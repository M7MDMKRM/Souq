@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section id="hero" class="hero section accent-background">
    <div class="container">
        <div class="row gy-4">
            <div class="col-lg-6 order-2 order-lg-1 d-flex flex-column justify-content-center" data-aos="fade-up">
                <h1>Everything You Need,<br>All in One Place</h1>
                <p>We are a passionate team dedicated to bringing you the best online shopping experience — quality products, unbeatable prices, and seamless delivery.</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Products" asp-action="Index" class="btn-get-started">Shop Now</a>
                    <a asp-controller="Home" asp-action="Categories" class="btn-get-started" style="background:transparent;border:2px solid #fff;">Browse Categories</a>
                </div>
            </div>
            <div class="col-lg-6 order-1 order-lg-2 hero-img" data-aos="zoom-out">
                <img src="~/assets/img/1.png" class="img-fluid animated" style="width: 110%; margin-left: 20px;" alt="Marketo Shopping">
            </div>
        </div>
    </div>
</section><!-- /Hero Section -->

<!-- Stats Section -->
