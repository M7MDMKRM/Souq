                <div style="padding:20px;">
                    <div style="font-size:2.4rem;font-weight:800;color:#5b21b6;">10K+</div>
                    <div style="color:#777;font-size:14px;margin-top:4px;">Happy Customers</div>
                </div>
            </div>
            <div class="col-lg-3 col-6" data-aos="fade-up" data-aos-delay="200">
                <div style="padding:20px;">
                    <div style="font-size:2.4rem;font-weight:800;color:#5b21b6;">5K+</div>
                    <div style="color:#777;font-size:14px;margin-top:4px;">Products</div>
                </div>
            </div>
            <div class="col-lg-3 col-6" data-aos="fade-up" data-aos-delay="300">
                <div style="padding:20px;">
                    <div style="font-size:2.4rem;font-weight:800;color:#5b21b6;">50+</div>
                    <div style="color:#777;font-size:14px;margin-top:4px;">Categories</div>
                </div>
            </div>
            <div class="col-lg-3 col-6" data-aos="fade-up" data-aos-delay="400">
                <div style="padding:20px;">
