                        </div>
                    </div>
                    <div style="display:flex;gap:14px;">
                        <div style="width:44px;height:44px;background:#ede9fe;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi bi-envelope-fill" style="color:#5b21b6;font-size:18px;"></i>
                        </div>
                        <div>
                            <div style="font-weight:600;color:#222;">Email</div>
                            <div style="color:#777;font-size:14px;margin-top:4px;">info@marketo.com</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div style="background:#fff;border-radius:16px;padding:36px 40px;box-shadow:0 4px 20px rgba(0,0,0,0.07);">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 animate-fade-up">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                        </div>
                    }
                    <form asp-controller="Reviews" asp-action="Create" method="post">
                        <div class="row gy-4">
                            <div class="col-md-6">
                                <label class="form-label" style="font-weight:600;color:#444;">Your Name</label>
                                <input name="Name" type="text" class="form-control" placeholder="John Doe" style="border-radius:8px;padding:10px 14px;border:1.5px solid #e0e0e0;" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="font-weight:600;color:#444;">Email Address</label>
                                <input name="Email" type="email" class="form-control" placeholder="john@example.com" style="border-radius:8px;padding:10px 14px;border:1.5px solid #e0e0e0;" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label" style="font-weight:600;color:#444;">Subject</label>
                                <input name="Subject" type="text" class="form-control" placeholder="How can we help?" style="border-radius:8px;padding:10px 14px;border:1.5px solid #e0e0e0;" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label" style="font-weight:600;color:#444;">Message</label>
                                <textarea name="Description" class="form-control" rows="5" placeholder="Write your message here..." style="border-radius:8px;padding:10px 14px;border:1.5px solid #e0e0e0;resize:none;" required></textarea>
                            </div>
                            <div class="col-12 text-end">
                                <button type="submit" class="btn-submit">Send Message <i class="bi bi-send ms-2"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>