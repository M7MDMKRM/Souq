                    <div class="card-body">
                        <h5 class="card-title">Classic Canvas Duffle Bag</h5>
                        <p class="card-text">A premium canvas duffle bag with genuine leather handles and straps, perfect for weekend getaways and gym sessions. Spacious main compartment with secure zip closure and adjustable shoulder strap for versatile carrying options.</p>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="price-tag">$50.60</span>
                            <div style="color:#f5a623;">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                            </div>
                        </div>
                        <div class="card-actions">
                            <a asp-controller="Home" asp-action="Cart" class="btn-cart"><i class="bi bi-cart-plus me-1"></i>Add to Cart</a>
                            <a asp-controller="Products" asp-action="Index" class="btn-details"><i class="bi bi-eye"></i></a>
                        </div>
                    </div>
                </div>
            </div>


        <div class="text-center mt-5" data-aos="fade-up">
