@{
    ViewData["Title"] = "Marketo | Admin Dashboard";
    Layout = "_Layout";
}

<!-- Chart.js Library -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="bg-theme-light pt-5 pb-5 min-vh-100">
    <div class="container pt-5 mt-4">

        <!-- Header Section -->
        <div class="d-flex align-items-center justify-content-between mb-5 animate-fade-up">
            <div>
                <h1 class="display-5 fw-bold text-dark mb-1">Control Center</h1>
                <p class="text-muted fs-5 mb-0">Overview of your marketplace performance and analytics.</p>
            </div>
            <div class="text-end d-none d-md-block">
                <div class="text-muted small fw-bold text-uppercase mb-1">System Status</div>
                <div class="badge rounded-pill bg-success px-3 py-2"><i class="bi bi-cpu-fill me-1"></i>All Systems Operational</div>
            </div>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <!-- Stats Overview Cards -->
            <div class="row g-4 mb-5">
                <div class="col-md-3 animate-fade-up" style="animation-delay: 0.1s;">
                    <div class="glass-stat-card p-4 rounded-4 shadow-sm h-100 border-0" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%); color: white;">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="bg-white bg-opacity-20 rounded-3 p-2"><i class="bi bi-wallet2 fs-4"></i></div>
                            <span class="badge bg-white bg-opacity-20 text-white">Live</span>
                        </div>
                        <h6 class="text-white-50 small fw-bold">Total Revenue</h6>
                        <h3 class="fw-bold mb-0">EGP @ViewBag.TotalRevenue</h3>
                    </div>
                </div>
                <div class="col-md-3 animate-fade-up" style="animation-delay: 0.2s;">
                    <div class="glass-stat-card p-4 rounded-4 shadow-sm h-100 border-0 bg-white">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="bg-primary bg-opacity-10 rounded-3 p-2 text-primary"><i class="bi bi-bag-check fs-4"></i></div>
                            <span class="badge bg-success bg-opacity-10 text-success">@ViewBag.SalesCount Items</span>
                        </div>
                        <h6 class="text-muted small fw-bold">Total Sales Items</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.SalesCount</h3>
                    </div>
                </div>
                <div class="col-md-3 animate-fade-up" style="animation-delay: 0.3s;">
                    <div class="glass-stat-card p-4 rounded-4 shadow-sm h-100 border-0 bg-white">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="bg-warning bg-opacity-10 rounded-3 p-2 text-warning"><i class="bi bi-box-seam fs-4"></i></div>
                            <span class="badge bg-warning bg-opacity-10 text-warning">@ViewBag.TotalCategories Cats</span>
                        </div>
                        <h6 class="text-muted small fw-bold">Active Products</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalProducts</h3>
                    </div>
                </div>
                <div class="col-md-3 animate-fade-up" style="animation-delay: 0.4s;">
                    <div class="glass-stat-card p-4 rounded-4 shadow-sm h-100 border-0 bg-white">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="bg-info bg-opacity-10 rounded-3 p-2 text-info"><i class="bi bi-chat-heart fs-4"></i></div>
                            <span class="badge bg-info bg-opacity-10 text-info">Reviews</span>
                        </div>
                        <h6 class="text-muted small fw-bold">Customer Feedback</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalReviews</h3>
                    </div>
                </div>
            </div>

            <!-- Analytics Charts -->
            <div class="row g-4 mb-5">
                <!-- Circular Chart (Sales Distribution) -->
                <div class="col-lg-5 animate-fade-up" style="animation-delay: 0.5s;">
                    <div class="bg-white rounded-4 shadow-sm p-4 h-100 border-0">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h5 class="fw-bold text-dark mb-0">Sales Distribution</h5>
                            <button class="btn btn-light btn-sm rounded-pill px-3">Live Data</button>
                        </div>
                        <div class="chart-container py-3" style="position: relative; height:300px;">
                            <canvas id="salesPieChart"></canvas>
                        </div>
                        <div class="row mt-4 g-2 text-center">
                            <div class="col-4">
                                <small class="text-muted d-block">Sales</small>
                                <span class="fw-bold text-primary">@ViewBag.SalesCount</span>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Returns</small>
                                <span class="fw-bold text-danger">@ViewBag.ReturnsCount</span>
                            </div>
                            <div class="col-4">
                                <small class="text-muted d-block">Pending</small>
                                <span class="fw-bold text-warning">@ViewBag.PendingCount</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Monthly Revenue Line Chart -->
                <div class="col-lg-7 animate-fade-up" style="animation-delay: 0.6s;">
                    <div class="bg-white rounded-4 shadow-sm p-4 h-100 border-0">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h5 class="fw-bold text-dark mb-0">Revenue Growth</h5>
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">Last 6 Months</button>
                                <ul class="dropdown-menu border-0 shadow">
                                    <li><a class="dropdown-item" href="#">Yearly</a></li>
                                    <li><a class="dropdown-item" href="#">Monthly</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="chart-container" style="position: relative; height:360px;">
                            <canvas id="revenueLineChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Admin Tools & Actions -->
            <div class="row g-4 mb-5">
                <div class="col-12 animate-fade-up" style="animation-delay: 0.7s;">
                    <div class="bg-white p-4 rounded-4 shadow-sm border-0">
                        <h5 class="fw-bold text-dark mb-4 px-2">Administrative Hub</h5>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <a asp-controller="Categories" asp-action="Index" class="admin-tool-btn text-decoration-none d-block p-4 rounded-4 text-center transition-hover">
                                    <i class="bi bi-folder2-open display-6 text-primary mb-2"></i>
                                    <span class="d-block fw-bold text-dark mt-2">Manage Categories</span>
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a asp-controller="Products" asp-action="Create" class="admin-tool-btn text-decoration-none d-block p-4 rounded-4 text-center transition-hover">
                                    <i class="bi bi-plus-circle display-6 text-success mb-2"></i>
                                    <span class="d-block fw-bold text-dark mt-2">Add New Product</span>
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a asp-controller="Products" asp-action="Index" class="admin-tool-btn text-decoration-none d-block p-4 rounded-4 text-center transition-hover">
                                    <i class="bi bi-grid-3x3-gap display-6 text-purple mb-2" style="color: #5b21b6;"></i>
                                    <span class="d-block fw-bold text-dark mt-2">Inventory List</span>
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a asp-controller="Reviews" asp-action="Index" class="admin-tool-btn text-decoration-none d-block p-4 rounded-4 text-center transition-hover">
                                    <i class="bi bi-star display-6 text-warning mb-2"></i>
                                    <span class="d-block fw-bold text-dark mt-2">Customer Reviews</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Customer View (Premium Redesign) -->
            <div class="row g-4 mb-5">
                <div class="col-md-3 animate-fade-up" style="animation-delay: 0.1s;">
                    <div class="glass-stat-card p-4 rounded-4 shadow-sm h-100 border-0" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%); color: white;">
                        <div class="bg-white bg-opacity-20 rounded-3 p-2 d-inline-block mb-3"><i class="bi bi-wallet2 fs-4"></i></div>
                        <h6 class="text-white-50 small fw-bold">Total Spent</h6>
                        <h3 class="fw-bold mb-0">EGP @ViewBag.TotalSpent</h3>
                    </div>
                </div>
                <div class="col-md-3 animate-fade-up" style="animation-delay: 0.2s;">
                    <div class="glass-stat-card p-4 rounded-4 shadow-sm h-100 border-0 bg-white border">
                        <div class="bg-primary bg-opacity-10 rounded-3 p-2 text-primary d-inline-block mb-3"><i class="bi bi-bag-check fs-4"></i></div>
                        <h6 class="text-muted small fw-bold">My Orders</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.MyOrdersCount</h3>
                    </div>
                </div>
                <div class="col-md-3 animate-fade-up" style="animation-delay: 0.3s;">
                    <div class="glass-stat-card p-4 rounded-4 shadow-sm h-100 border-0 bg-white border">
                        <div class="bg-info bg-opacity-10 rounded-3 p-2 text-info d-inline-block mb-3"><i class="bi bi-cart3 fs-4"></i></div>
                        <h6 class="text-muted small fw-bold">Items in Cart</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.MyCartCount</h3>
                    </div>
                </div>
                <div class="col-md-3 animate-fade-up" style="animation-delay: 0.4s;">
                    <div class="glass-stat-card p-4 rounded-4 shadow-sm h-100 border-0 bg-white border">
                        <div class="bg-danger bg-opacity-10 rounded-3 p-2 text-danger d-inline-block mb-3"><i class="bi bi-heart fs-4"></i></div>
                        <h6 class="text-muted small fw-bold">Wishlist</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.MyWishlistCount</h3>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Recent Orders -->
                <div class="col-lg-8 animate-fade-up" style="animation-delay: 0.5s;">
                    <div class="bg-white rounded-4 shadow-sm p-4 h-100 border-0 border">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h5 class="fw-bold text-dark mb-0">Recent Orders</h5>
                            <a href="#" class="btn btn-light btn-sm rounded-pill px-3">View All</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="border-0 small text-uppercase">Order ID</th>
                                        <th class="border-0 small text-uppercase">Date</th>
                                        <th class="border-0 small text-uppercase">Status</th>
                                        <th class="border-0 small text-uppercase text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ViewBag.RecentOrders != null && ((List<Souq.Models.Order>)ViewBag.RecentOrders).Any())
                                    {
                                        foreach (var order in (List<Souq.Models.Order>)ViewBag.RecentOrders)
                                        {
                                            <tr>
                                                <td class="fw-bold">#@order.Id</td>
                                                <td class="text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    @{
                                                        var statusClass = order.Status switch {
                                                            "Pending" => "bg-warning",
                                                            "Delivered" => "bg-success",
                                                            "Cancelled" => "bg-danger",
                                                            _ => "bg-info"
                                                        };
                                                    }
                                                    <span class="badge @statusClass bg-opacity-10 text-dark" style="color: inherit !important;">@order.Status</span>
                                                </td>
                                                <td class="text-end fw-bold">EGP @order.TotalAmount</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">No orders found yet.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="col-lg-4 animate-fade-up" style="animation-delay: 0.6s;">
                    <div class="bg-white rounded-4 shadow-sm p-4 h-100 border-0 border">
                        <h5 class="fw-bold text-dark mb-4">Quick Actions</h5>
                        <div class="d-grid gap-3">
                            <a asp-controller="Products" asp-action="Index" class="d-flex align-items-center gap-3 p-3 rounded-4 bg-light text-decoration-none transition-hover">
                                <div class="bg-white rounded-3 p-2 shadow-sm text-primary"><i class="bi bi-search"></i></div>
                                <div>
                                    <div class="fw-bold text-dark">Browse Store</div>
                                    <small class="text-muted">Discover new products</small>
                                </div>
                            </a>
                            <a asp-controller="Home" asp-action="Cart" class="d-flex align-items-center gap-3 p-3 rounded-4 bg-light text-decoration-none transition-hover">
                                <div class="bg-white rounded-3 p-2 shadow-sm text-success"><i class="bi bi-cart-check"></i></div>
                                <div>
                                    <div class="fw-bold text-dark">My Shopping Cart</div>
                                    <small class="text-muted">@(ViewBag.MyCartCount) items waiting</small>
                                </div>
                            </a>
                            <a asp-controller="Wishlist" asp-action="Index" class="d-flex align-items-center gap-3 p-3 rounded-4 bg-light text-decoration-none transition-hover">
                                <div class="bg-white rounded-3 p-2 shadow-sm text-danger"><i class="bi bi-heart"></i></div>
                                <div>
                                    <div class="fw-bold text-dark">Saved Wishlist</div>
                                    <small class="text-muted">View your favorite items</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

<style>
    .glass-stat-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05) !important;
    }
    .glass-stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.1) !important;
    }

    .admin-tool-btn {
        background: #f8f9fa;
        border: 1px solid transparent;
    }
    .admin-tool-btn:hover {
        background: #fff;
        border-color: #5b21b6;
        box-shadow: 0 10px 20px rgba(91, 33, 182, 0.05);
    }

    .animate-fade-up {
        animation: fadeUp 0.8s ease-out forwards;
        opacity: 0;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
    // Sales Pie Chart
    const ctxPie = document.getElementById('salesPieChart').getContext('2d');
    new Chart(ctxPie, {
        type: 'doughnut',
        data: {
            labels: ['Sales', 'Returns', 'Pending'],
            datasets: [{
                data: [@ViewBag.SalesCount, @ViewBag.ReturnsCount, @ViewBag.PendingCount],
                backgroundColor: ['#5b21b6', '#ef4444', '#f59e0b'],
                borderWidth: 0,
                hoverOffset: 10
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        padding: 20,
                        font: { size: 12, weight: 'bold' }
                    }
                }
            },
            cutout: '70%'
        }
    });

    // Revenue Growth Line Chart
    const ctxLine = document.getElementById('revenueLineChart').getContext('2d');
    const gradient = ctxLine.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, 'rgba(91, 33, 182, 0.2)');
    gradient.addColorStop(1, 'rgba(91, 33, 182, 0)');

    new Chart(ctxLine, {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
            datasets: [{
                label: 'Revenue',
                data: [12000, 19000, 15000, 25000, 22000, 30000],
                borderColor: '#5b21b6',
                backgroundColor: gradient,
                borderWidth: 4,
                fill: true,
                tension: 0.4,
                pointRadius: 6,
                pointBackgroundColor: '#fff',
                pointBorderColor: '#5b21b6',
                pointBorderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(0,0,0,0.05)', drawBorder: false },
                    ticks: { callback: value => 'EGP ' + value }
                },
                x: {
                    grid: { display: false, drawBorder: false }
                }
            }
        }
    });
</script>
