@{
    ViewData["Title"] = "User Dashboard";
}

<!-- Page Hero -->
<div class="page-hero text-center mb-5">
    <div class="container">
        <h1>Welcome to Your Dashboard</h1>
        <p class="mb-0 text-white-50">Manage your account, view your cart, and continue shopping.</p>
    </div>
</div>

<div class="container inner-page-content pt-0">
    <div class="row g-4">
        
        <!-- Profile Summary Card -->
        <div class="col-lg-4">
            <div class="form-card text-center h-100 d-flex flex-column justify-content-center">
                <i class="bi bi-person-circle text-primary" style="font-size: 4rem; color: var(--accent-color) !important;"></i>
                <h3 class="mt-3">@User.Identity?.Name</h3>
                <p class="text-muted">Registered Customer</p>
                <hr />
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-outline-primary mt-2 mx-auto" style="border-color: var(--accent-color); color: var(--accent-color);">Manage Profile</a>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-lg-8">
            <div class="row g-4 h-100">
                <!-- Cart Actions -->
                <div class="col-md-6">
                    <div class="category-card h-100" style="display: flex; flex-direction: column; justify-content: center;">
                        <i class="bi bi-cart-check cat-icon"></i>
                        <div class="cat-body">
                            <h5>Your Shopping Cart</h5>
                            <p>Review items you've added to your cart and proceed to checkout securely.</p>
                            <a asp-controller="Home" asp-action="Cart" class="btn-submit text-decoration-none mt-2 d-inline-block">View Cart</a>
                        </div>
                    </div>
                </div>

                <!-- Shopping Action -->
                <div class="col-md-6">
                    <div class="category-card h-100" style="display: flex; flex-direction: column; justify-content: center;">
                        <i class="bi bi-bag-heart cat-icon"></i>
                        <div class="cat-body">
                            <h5>Explore Products</h5>
                            <p>Discover new products and find the best deals available in our store.</p>
                            <a asp-controller="Products" asp-action="Index" class="btn-submit text-decoration-none mt-2 d-inline-block" style="background: #333;">Start Shopping</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Admin Controls -->
        <div class="col-12 mt-5">
            <h4 class="mb-4" style="color: var(--accent-color); border-bottom: 2px solid #eee; padding-bottom: 10px;">Admin Controls</h4>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="category-card h-100" style="display: flex; flex-direction: column; justify-content: center;">
                        <i class="bi bi-tags cat-icon" style="font-size: 36px; padding: 20px 0 10px;"></i>
                        <div class="cat-body">
                            <h5>Categories</h5>
                            <a asp-controller="Categories" asp-action="Index" class="btn-submit text-decoration-none mt-2 d-inline-block w-100" style="padding: 8px;">Manage Categories</a>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="category-card h-100" style="display: flex; flex-direction: column; justify-content: center;">
                        <i class="bi bi-box-seam cat-icon" style="font-size: 36px; padding: 20px 0 10px;"></i>
                        <div class="cat-body">
                            <h5>Products</h5>
                            <a asp-controller="Products" asp-action="Create" class="btn-submit text-decoration-none mt-2 d-inline-block w-100" style="padding: 8px;">Add New Product</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="category-card h-100" style="display: flex; flex-direction: column; justify-content: center;">
                        <i class="bi bi-star cat-icon" style="font-size: 36px; padding: 20px 0 10px;"></i>
                        <div class="cat-body">
                            <h5>Reviews</h5>
                            <a asp-controller="Reviews" asp-action="Index" class="btn-submit text-decoration-none mt-2 d-inline-block w-100" style="padding: 8px;">Manage Reviews</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
