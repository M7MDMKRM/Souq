@model Souq.Models.Product

@{
    ViewData["Title"] = "Add New Product - Marketo";
    Layout = "_Layout";
}

<div class="min-vh-100 py-5" style="background: radial-gradient(circle at top right, #5b21b6 0%, #1e1b4b 100%);">
    <div class="container pt-5 mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                
                <!-- Header Area -->
                <div class="d-flex align-items-center justify-content-between mb-5 animate-fade-up">
                    <div>
                        <h1 class="display-5 fw-bold text-white mb-2">Add New Product</h1>
                        <p class="text-white-50 fs-5 mb-0">Expand your inventory with a new premium item.</p>
                    </div>
                    <a href="javascript:history.back()" class="btn btn-glass-secondary rounded-pill px-4 py-2 text-white border-white border-opacity-10 text-decoration-none">
                        <i class="bi bi-arrow-left me-2"></i>Back to previous
                    </a>
                </div>

                <div class="glass-card shadow-2xl animate-fade-up overflow-hidden" style="border-radius: 40px; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1);">
                    <div class="row g-0">
                        
                        <!-- Left Panel: Preview -->
                        <div class="col-md-5 p-5 text-center d-flex flex-column align-items-center justify-content-center border-end border-white border-opacity-10">
                            <div class="mb-4">
                                <h4 class="text-white fw-bold mb-4">Live Preview</h4>
                                <div class="position-relative p-3" style="background: rgba(255,255,255,0.05); border-radius: 30px; border: 1px solid rgba(255,255,255,0.1);">
                                    <img id="imagePreview" src="https://placehold.co/400x400/5b21b6/white?text=New+Product"
                                         class="rounded-4 shadow-lg object-fit-contain" 
                                         style="width: 100%; aspect-ratio: 1/1; max-width: 300px; background: white;" alt="Preview" />
                                    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-n3">
                                        <span class="badge rounded-pill bg-primary px-4 py-2 shadow-lg fs-6">EGP <span id="pricePreview">0.00</span></span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4 text-start w-100">
                                <h5 id="namePreview" class="text-white fw-bold mb-2">New Product Name</h5>
                                <p id="descPreview" class="text-white-50 small mb-0">Product description will appear here...</p>
                            </div>
                        </div>

                        <!-- Right Panel: Form -->
                        <div class="col-md-7 p-4 p-md-5">
                            <form asp-action="Create" method="post" enctype="multipart/form-data">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 mb-4 bg-danger bg-opacity-25 text-white"></div>

                                <div class="row g-4">
                                    <div class="col-12">
                                        <label asp-for="Name" class="form-label text-white-50 small text-uppercase fw-bold mb-2">Product Name</label>
                                        <input asp-for="Name" id="nameInput" class="form-control glass-input" placeholder="Enter product name..." />
                                        <span asp-validation-for="Name" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="Price" class="form-label text-white-50 small text-uppercase fw-bold mb-2">Price (EGP)</label>
                                        <input asp-for="Price" id="priceInput" type="number" step="0.01" class="form-control glass-input" placeholder="0.00" />
                                        <span asp-validation-for="Price" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Catid" class="form-label text-white-50 small text-uppercase fw-bold mb-2">Category ID</label>
                                        <input asp-for="Catid" class="form-control glass-input" placeholder="Category #" />
                                        <span asp-validation-for="Catid" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="Description" class="form-label text-white-50 small text-uppercase fw-bold mb-2">Description</label>
                                        <textarea asp-for="Description" id="descInput" rows="4" class="form-control glass-input" placeholder="Tell customers about this product..."></textarea>
                                        <span asp-validation-for="Description" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <div class="glass-card p-3 d-flex align-items-center justify-content-between" style="background: rgba(255,255,255,0.05); border-radius: 15px; border: 1px solid rgba(255,255,255,0.1);">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="bg-primary bg-opacity-20 rounded-3 p-2 text-primary"><i class="bi bi-star-fill"></i></div>
                                                <div>
                                                    <h6 class="text-white mb-0">Feature on Home Page</h6>
                                                    <small class="text-white-50">Show in "Featured" section</small>
                                                </div>
                                            </div>
                                            <div class="form-check form-switch fs-4">
                                                <input class="form-check-input custom-switch" type="checkbox" asp-for="IsFeatured" style="cursor: pointer;">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label text-white-50 small text-uppercase fw-bold mb-2">Product Photo</label>
                                        <div class="upload-btn-wrapper w-100">
                                            <button class="btn btn-glass-primary w-100 rounded-4 py-3 border-dashed" type="button">
                                                <i class="bi bi-cloud-arrow-up me-2"></i>Upload Product Image
                                            </button>
                                            <input type="file" name="PhotoFile" onchange="previewFile(this)" accept="image/*" />
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-5">
                                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 w-100 shadow-lg border-0" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);">
                                        <i class="bi bi-plus-circle-fill me-2"></i>Create Product
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-input {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: white !important;
        border-radius: 15px !important;
        padding: 12px 20px !important;
    }
    .glass-input:focus {
        background: rgba(255, 255, 255, 0.1) !important;
        border-color: #a78bfa !important;
        box-shadow: 0 0 0 4px rgba(167, 139, 250, 0.1) !important;
    }
    .btn-glass-primary {
        background: rgba(124, 58, 237, 0.1);
        border: 1px solid rgba(124, 58, 237, 0.2);
        color: #a78bfa;
    }
    .btn-glass-secondary {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
    }
    .border-dashed { border-style: dashed !important; }
    .upload-btn-wrapper { position: relative; overflow: hidden; }
    .upload-btn-wrapper input[type=file] {
        position: absolute; left: 0; top: 0; opacity: 0; cursor: pointer; font-size: 100px;
    }
    .custom-switch:checked { background-color: #7c3aed !important; border-color: #7c3aed !important; }
    .custom-switch { background-color: rgba(255,255,255,0.1) !important; border-color: rgba(255,255,255,0.2) !important; }
    
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up { animation: fadeInUp 0.6s ease forwards; }
</style>

@section Scripts {
    <script>
        document.getElementById('nameInput').addEventListener('input', e => {
            document.getElementById('namePreview').textContent = e.target.value || "New Product Name";
        });
        document.getElementById('priceInput').addEventListener('input', e => {
            document.getElementById('pricePreview').textContent = e.target.value || "0.00";
        });
        document.getElementById('descInput').addEventListener('input', e => {
            document.getElementById('descPreview').textContent = e.target.value || "Product description will appear here...";
        });

        function previewFile(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imagePreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}