@model Souq.Models.Product
@{
    ViewData["Title"] = Model?.Name + " | Marketo";
}

<div class="pt-5 pb-5" style="background: linear-gradient(135deg, #5b21b6 0%, #310d6b 100%);">
    <div class="container pt-5 mt-4">
        <nav aria-label="breadcrumb" class="animate-fade-up">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" class="text-white-50">Products</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">@Model?.Name</li>
            </ol>
        </nav>
        <h1 class="display-5 fw-bold text-white animate-fade-up">Product Details</h1>
    </div>
</div>

<div class="bg-theme-light py-5 min-vh-100">
    <div class="container">
        <div class="bg-white rounded-5 shadow-lg overflow-hidden animate-fade-up border-0">
            <div class="row g-0">
                <!-- Product Image Container -->
                <div class="col-lg-5 d-flex align-items-center justify-content-center p-4 p-md-5" style="background-color: #f8f9fa;">
                    <div class="product-image-card bg-white rounded-4 shadow-sm p-4 w-100 position-relative d-flex align-items-center justify-content-center" style="min-height: 400px; border: 1px solid rgba(0,0,0,0.05);">
                        <div class="position-absolute top-0 start-0 m-3">
                            <span class="badge rounded-pill bg-light text-primary shadow-sm px-3 py-2 fw-bold" style="font-size: 0.75rem;">ID #@Model?.Id</span>
                        </div>
                        <img src="@Model?.Photo" class="img-fluid transition-transform" style="max-height: 350px; object-fit: contain;" alt="@Model?.Name">
                    </div>
                </div>

                <!-- Product Details Content -->
                <div class="col-lg-7 p-4 p-md-5 d-flex flex-column">
                    <div class="mb-auto">
                        <span class="badge rounded-pill px-3 py-2 fw-bold mb-3" style="background-color: #e0e7ff; color: #4f46e5;">Category #@Model?.Catid</span>
                        <h1 class="fw-bold text-dark display-5 mb-3">@Model?.Name</h1>
                        
                        <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                            <h2 class="fw-bold mb-0 display-6" style="color: #5b21b6;">EGP @Model?.Price</h2>
                            <div class="d-flex gap-1 text-warning ms-md-3">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-half"></i>
                            </div>
                            <span class="text-muted small fw-bold">(4.5/5 Customer Rating)</span>
                        </div>

                        <h5 class="fw-bold text-dark mb-2">Description</h5>
                        <p class="text-muted mb-4" style="line-height: 1.6; font-size: 1.05rem;">
                            @Model?.Description
                        </p>

                        <!-- Features List -->
                        <div class="row g-3 mb-5">
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2 text-muted small">
                                    <i class="bi bi-truck text-primary"></i> Free Express Shipping
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2 text-muted small">
                                    <i class="bi bi-shield-check text-primary"></i> 2 Year Warranty
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2 text-muted small">
                                    <i class="bi bi-arrow-repeat text-primary"></i> 30-Day Easy Return
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2 text-muted small">
                                    <i class="bi bi-patch-check text-primary"></i> 100% Original Product
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-3 pt-4 border-top">
                        <form asp-controller="Home" asp-action="AddToCart" method="post" class="flex-grow-1">
                            <input type="hidden" name="productId" value="@Model?.Id" />
                            <button type="submit" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-lg border-0 d-flex align-items-center justify-content-center gap-2" style="background: #5b21b6;">
                                <i class="bi bi-cart-plus fs-5"></i> Add to Shopping Cart
                            </button>
                        </form>
                        <form asp-controller="Wishlist" asp-action="Toggle" method="post">
                            <input type="hidden" name="productId" value="@Model?.Id" />
                            <button type="submit" class="btn btn-outline-danger rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 58px; height: 58px; border-width: 1px;">
                                <i class="bi bi-heart fs-4"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Back Link -->
        <div class="text-center mt-5 animate-fade-up">
            <a asp-action="Index" class="text-decoration-none text-muted fw-bold hover-primary">
                <i class="bi bi-arrow-left me-2"></i>Continue Browsing Marketplace
            </a>
        </div>
    </div>
</div>

<style>
    .animate-fade-up {
        animation: fadeUp 0.8s ease-out forwards;
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .breadcrumb-item + .breadcrumb-item::before {
        color: rgba(255, 255, 255, 0.5);
        content: "/";
    }
    .hover-primary:hover {
        color: #5b21b6 !important;
    }
    .product-image-card img {
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .product-image-card:hover img {
        transform: scale(1.08);
    }
</style>
