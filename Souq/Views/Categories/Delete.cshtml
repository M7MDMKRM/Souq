@model Souq.Models.Category

@{
    ViewData["Title"] = "Delete Category - Marketo";
    Layout = "_Layout";
}

<div class="min-vh-100 py-5" style="background: radial-gradient(circle at top right, #5b21b6 0%, #1e1b4b 100%);">
    <div class="container pt-5 mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                
                <!-- Header Area -->
                <div class="text-center mb-5 animate-fade-up">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 rounded-pill p-3 mb-4" style="width: 80px; height: 80px; border: 1px solid rgba(220, 53, 69, 0.2);">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                    </div>
                    <h1 class="display-5 fw-bold text-white mb-2">Delete Category?</h1>
                    <p class="text-white-50 fs-5 mb-0">Removing this category might affect associated products. Are you sure?</p>
                </div>

                <div class="glass-card shadow-2xl animate-fade-up overflow-hidden p-4 p-md-5" style="border-radius: 40px; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1);">
                    
                    <!-- Category Preview Card -->
                    <div class="bg-white bg-opacity-5 rounded-4 p-4 mb-5 border border-white border-opacity-10">
                        <div class="row align-items-center g-4">
                            <div class="col-md-4">
                                <img src="@(string.IsNullOrEmpty(Model.Photo) ? "https://placehold.co/400x400/5b21b6/white?text=Category" : Model.Photo)" 
                                     class="rounded-3 shadow-lg w-100 object-fit-cover" 
                                     style="aspect-ratio: 16/9; background: white;" alt="Category">
                            </div>
                            <div class="col-md-8">
                                <h4 class="text-white fw-bold mb-1">@Model.Name</h4>
                                <p class="text-white-50 small mb-0">@Model.Description</p>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex flex-column gap-3">
                            <button type="submit" class="btn btn-danger btn-lg rounded-pill py-3 fw-bold shadow-lg border-0 transition-hover" style="background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);">
                                <i class="bi bi-trash3-fill me-2"></i>Confirm Deletion
                            </button>
                            <a asp-action="Index" class="btn btn-glass-secondary btn-lg rounded-pill py-3 text-white border-white border-opacity-10 transition-hover text-decoration-none text-center">
                                <i class="bi bi-arrow-left me-2"></i>Go Back
                            </a>
                        </div>
                    </form>
                </div>

                <!-- Footer Link -->
                <div class="text-center mt-5 animate-fade-up">
                    <a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none hover-white">
                        <i class="bi bi-house-door me-1"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .shadow-2xl {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    .btn-glass-secondary {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
    }
    .btn-glass-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }
    .transition-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px -5px rgba(0,0,0,0.3);
    }
    .hover-white:hover {
        color: white !important;
    }
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeInUp 0.6s ease forwards;
    }
</style>
