@model IEnumerable<Souq.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
}

<!-- Page Hero -->
<div class="page-hero">
    <div class="container d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1><i class="bi bi-grid me-2"></i>Manage Categories</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Categories</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Create" class="btn-submit" style="display:inline-flex;align-items:center;gap:8px;padding:10px 24px;border-radius:8px;text-decoration:none;">
            <i class="bi bi-plus-circle"></i> Add Category
        </a>
    </div>
</div>

<!-- Categories Grid -->
<section class="inner-page-content">
    <div class="container">

        @if (Model != null && Model.Any())
        {
            <div class="row gy-4">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6" data-aos="fade-up">
                        <div class="category-card">
                            <div class="cat-img-wrap">
                                @if (!string.IsNullOrEmpty(item.Photo))
                                {
                                    <img src="@item.Photo" alt="@item.Name">
                                }
                                else
                                {
                                    <div class="cat-icon"><i class="bi bi-grid-3x3-gap"></i></div>
                                }
                            </div>
                            <div class="cat-body">
                                <h5>@item.Name</h5>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p>@(item.Description?.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)</p>
                                }
                                <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:12px;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-details">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-delete"
                                       onclick="return confirm('Delete this category?')">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5" data-aos="fade-up">
                <i class="bi bi-grid" style="font-size:80px;color:#e84545;opacity:0.3;"></i>
                <h4 style="color:#666;margin-top:20px;">No Categories Yet</h4>
                <p style="color:#999;">Start by creating your first product category.</p>
                <a asp-action="Create" class="btn-submit" style="display:inline-block;margin-top:16px;padding:12px 32px;border-radius:8px;text-decoration:none;">
                    <i class="bi bi-plus-circle me-2"></i>Add First Category
                </a>
            </div>
        }

    </div>
</section>
