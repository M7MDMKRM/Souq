@model IEnumerable<Souq.Models.Category>

@{
    ViewData["Title"] = "Store Categories - Marketo";
}

<div class="pt-5 pb-5" style="background: linear-gradient(135deg, #5b21b6 0%, #310d6b 100%);">
    <div class="container pt-5 mt-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="animate-fade-up">
            <h1 class="fw-bold text-white mb-1"><i class="bi bi-grid-fill me-2"></i>Manage Categories</h1>
            <p class="text-white-50 mb-0">Organize your products into logical collections for easy browsing.</p>
        </div>
        <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 fw-bold animate-fade-up" style="color: #5b21b6;">
            <i class="bi bi-plus-lg me-2"></i>Add Category
        </a>
    </div>
</div>

<div class="bg-theme-light py-5 min-vh-100">
    <div class="container">
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 animate-fade-up">
                        <div class="bg-white rounded-4 shadow-sm h-100 transition-hover border-0 overflow-hidden" style="border: 1px solid rgba(0,0,0,0.05) !important;">
                            <!-- Category Image -->
                            <div class="position-relative overflow-hidden" style="height: 180px; background: #f8f9fa;">
                                @if (!string.IsNullOrEmpty(item.Photo))
                                {
                                    <img src="@item.Photo" class="w-100 h-100 object-fit-cover" alt="@item.Name">
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light text-muted opacity-50">
                                        <i class="bi bi-image fs-1"></i>
                                    </div>
                                }
                                <div class="position-absolute top-0 end-0 m-3">
                                    <span class="badge rounded-pill bg-white text-dark shadow-sm px-3 py-2 fw-bold">ID #@item.Id</span>
                                </div>
                            </div>

                            <!-- Content -->
                            <div class="p-4">
                                <h5 class="fw-bold text-dark mb-2">@item.Name</h5>
                                <p class="text-muted small mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 40px;">
                                    @item.Description
                                </p>
                                
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary flex-grow-1 rounded-pill py-2 shadow-sm border-0" style="background: #5b21b6;">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                    <div class="dropdown">
                                        <button class="btn btn-light rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown" style="width: 42px; height: 42px;">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-3 p-2">
                                            <li><a class="dropdown-item rounded-2 py-2" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-eye me-2"></i>Details</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item rounded-2 py-2 text-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash me-2"></i>Delete</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-grid-3x3-gap display-1 text-muted opacity-25"></i>
                <h4 class="mt-4 fw-bold">No categories found</h4>
                <p class="text-muted">Start by creating your first product category.</p>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 mt-3">Create Category</a>
            </div>
        }
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .transition-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.1) !important;
    }
    .animate-fade-up {
        animation: fadeUp 0.8s ease-out forwards;
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
