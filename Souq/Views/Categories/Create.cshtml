@model Souq.Models.Category

@{
    ViewData["Title"] = "Add Category";
}

<!-- Page Hero -->
<div class="page-hero">
    <div class="container">
        <h1><i class="bi bi-plus-circle me-2"></i>Add New Category</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Categories</a></li>
                <li class="breadcrumb-item active">Create</li>
            </ol>
        </nav>
    </div>
</div>

<section class="inner-page-content">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9" data-aos="fade-up">
                <div class="form-card">
                    <div style="display:flex;align-items:center;gap:14px;margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid #f0f0f0;">
                        <div style="width:50px;height:50px;background:#ffebee;border-radius:12px;display:flex;align-items:center;justify-content:center;">
                            <i class="bi bi-grid" style="color:#e84545;font-size:22px;"></i>
                        </div>
                        <div>
                            <h4 style="font-weight:700;margin:0;color:#222;">Category Information</h4>
                            <p style="color:#999;font-size:13px;margin:2px 0 0;">Fill in the details for the new category</p>
                        </div>
                    </div>

                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row gy-4">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label">Category Name <span style="color:#e84545;">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g. Electronics, Fashion..." />
                                <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Photo" class="form-label">Photo URL</label>
                                <input asp-for="Photo" class="form-control" placeholder="https://example.com/category-image.jpg" />
                                <span asp-validation-for="Photo" class="text-danger" style="font-size:12px;"></span>
                                <small style="color:#aaa;font-size:12px;margin-top:4px;display:block;">Enter a URL for the category cover image</small>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Briefly describe this category..." style="border-radius:8px;padding:10px 14px;border:1.5px solid #e0e0e0;resize:vertical;"></textarea>
                                <span asp-validation-for="Description" class="text-danger" style="font-size:12px;"></span>
                            </div>
                        </div>

                        <div style="display:flex;gap:12px;margin-top:32px;padding-top:24px;border-top:1px solid #f0f0f0;">
                            <button type="submit" class="btn-submit" style="padding:12px 32px;border-radius:8px;">
                                <i class="bi bi-check-circle me-2"></i>Create Category
                            </button>
                            <a asp-action="Index" class="btn-details" style="padding:12px 24px;border-radius:8px;display:inline-flex;align-items:center;gap:6px;">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
