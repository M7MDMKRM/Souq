@model Souq.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<!-- Page Hero -->
<div class="page-hero">
    <div class="container">
        <h1><i class="bi bi-info-circle me-2"></i>Category Details</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Categories</a></li>
                <li class="breadcrumb-item active">@Model?.Name</li>
            </ol>
        </nav>
    </div>
</div>

<section class="inner-page-content">
    <div class="container">
        <div class="row gy-5 align-items-start justify-content-center">

            <!-- Category Image -->
            <div class="col-lg-4 col-md-6" data-aos="fade-right">
                <div style="background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.10);">
                    @if (!string.IsNullOrEmpty(Model?.Photo))
                    {
                        <img src="@Model.Photo" alt="@Model.Name" style="width:100%;height:260px;object-fit:cover;">
                    }
                    else
                    {
                        <div style="height:260px;background:linear-gradient(135deg,#ffebee,#fff0f0);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;">
                            <i class="bi bi-grid-3x3-gap" style="font-size:70px;color:#e84545;opacity:0.35;"></i>
                            <span style="color:#bbb;font-size:14px;">No image</span>
                        </div>
                    }
                    <div style="padding:20px;background:#fff;">
                        <h4 style="font-weight:800;color:#222;margin:0;">@Model?.Name</h4>
                        <span style="background:#ffebee;color:#e84545;font-size:11px;font-weight:600;padding:3px 12px;border-radius:20px;display:inline-block;margin-top:8px;">Category #@Model?.Id</span>
                    </div>
                </div>
            </div>

            <!-- Category Info -->
            <div class="col-lg-6 col-md-8" data-aos="fade-left">
                <div style="background:#fff;border-radius:20px;padding:36px;box-shadow:0 8px 32px rgba(0,0,0,0.08);">

                    <h3 style="font-weight:800;color:#222;margin-bottom:24px;">@Model?.Name</h3>

                    @if (!string.IsNullOrEmpty(Model?.Description))
                    {
                        <div style="margin-bottom:24px;">
                            <h6 style="font-weight:700;color:#555;text-transform:uppercase;font-size:11px;letter-spacing:1px;margin-bottom:8px;">Description</h6>
                            <p style="color:#666;line-height:1.8;font-size:15px;">@Model.Description</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model?.Photo))
                    {
                        <div style="margin-bottom:24px;padding:14px 16px;background:#f8f8f8;border-radius:10px;">
                            <h6 style="font-weight:700;color:#555;text-transform:uppercase;font-size:11px;letter-spacing:1px;margin-bottom:6px;">Photo URL</h6>
                            <p style="color:#888;font-size:13px;word-break:break-all;margin:0;">@Model.Photo</p>
                        </div>
                    }

                    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:30px;padding-top:24px;border-top:1px solid #f0f0f0;">
                        <a asp-action="Edit" asp-route-id="@Model?.Id"
                           class="btn-submit" style="display:inline-flex;align-items:center;gap:8px;padding:12px 28px;border-radius:10px;text-decoration:none;background:#f57c00;">
                            <i class="bi bi-pencil"></i> Edit Category
                        </a>
                        <a asp-controller="Products" asp-action="Index"
                           class="btn-details" style="display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:10px;background:#e8f5e9;color:#2e7d32;">
                            <i class="bi bi-box-seam"></i> View Products
                        </a>
                        <a asp-action="Index"
                           class="btn-details" style="display:inline-flex;align-items:center;gap:8px;padding:12px 24px;border-radius:10px;">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
