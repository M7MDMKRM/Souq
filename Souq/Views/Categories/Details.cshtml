@model Souq.Models.Category

@{
    ViewData["Title"] = "Category Details - Marketo";
    Layout = "_Layout";
}

<div class="min-vh-100 py-5" style="background: radial-gradient(circle at top right, #5b21b6 0%, #1e1b4b 100%);">
    <div class="container pt-5 mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                
                <!-- Header Area -->
                <div class="d-flex align-items-center justify-content-between mb-5 animate-fade-up">
                    <div>
                        <h1 class="display-5 fw-bold text-white mb-2">Category Details</h1>
                        <p class="text-white-50 fs-5 mb-0">Overview of the category and its properties.</p>
                    </div>
                    <a asp-action="Index" class="btn btn-glass-secondary rounded-pill px-4 py-2 text-white border-white border-opacity-10 text-decoration-none">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                </div>

                <div class="glass-card shadow-2xl animate-fade-up overflow-hidden" style="border-radius: 40px; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1);">
                    <div class="row g-0">
                        
                        <!-- Left Panel: Image -->
                        <div class="col-md-5 p-5 text-center d-flex flex-column align-items-center justify-content-center border-end border-white border-opacity-10">
                            <div class="mb-4">
                                <div class="position-relative p-3" style="background: rgba(255,255,255,0.05); border-radius: 30px; border: 1px solid rgba(255,255,255,0.1);">
                                    <img src="@(string.IsNullOrEmpty(Model.Photo) ? "https://placehold.co/600x400/5b21b6/white?text=Category+Image" : Model.Photo)"
                                         class="rounded-4 shadow-lg object-fit-cover w-100" 
                                         style="aspect-ratio: 4/3; background: white;" alt="@Model.Name" />
                                </div>
                            </div>
                            <span class="badge rounded-pill bg-primary px-4 py-2 shadow-lg fs-6">ID: #@Model.Id</span>
                        </div>

                        <!-- Right Panel: Info -->
                        <div class="col-md-7 p-4 p-md-5">
                            <div class="mb-5">
                                <label class="text-white-50 small text-uppercase fw-bold mb-2 d-block">Category Name</label>
                                <h2 class="text-white fw-bold">@Model.Name</h2>
                            </div>

                            <div class="mb-5">
                                <label class="text-white-50 small text-uppercase fw-bold mb-2 d-block">Description</label>
                                <p class="text-white fs-5 opacity-75">@Model.Description</p>
                            </div>

                            <div class="mb-5">
                                <label class="text-white-50 small text-uppercase fw-bold mb-2 d-block">Photo URL</label>
                                <div class="p-3 rounded-3 bg-white bg-opacity-5 border border-white border-opacity-10">
                                    <code class="text-primary small word-break-all">@Model.Photo</code>
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-5 pt-4 border-top border-white border-opacity-10">
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-lg rounded-pill px-5 shadow-lg border-0 flex-grow-1 text-decoration-none text-center" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);">
                                    <i class="bi bi-pencil-square me-2"></i>Edit Category
                                </a>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-lg rounded-pill px-4 shadow-sm text-decoration-none text-center">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        transition: transform 0.3s ease;
    }
    .shadow-2xl {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    .btn-glass-secondary {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
    }
    .btn-glass-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateX(-5px);
    }
    .word-break-all {
        word-break: break-all;
    }
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up {
        animation: fadeInUp 0.6s ease forwards;
    }
</style>
