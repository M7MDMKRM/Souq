@model Souq.Models.Category

@{
    ViewData["Title"] = "Edit Category - Marketo";
    Layout = "_Layout";
}

<div class="min-vh-100 py-5" style="background: radial-gradient(circle at top right, #5b21b6 0%, #1e1b4b 100%);">
    <div class="container pt-5 mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                
                <!-- Header Area -->
                <div class="d-flex align-items-center justify-content-between mb-5 animate-fade-up">
                    <div>
                        <h1 class="display-5 fw-bold text-white mb-2">Edit Category</h1>
                        <p class="text-white-50 fs-5 mb-0">Update your category details and imagery.</p>
                    </div>
                    <a href="javascript:history.back()" class="btn btn-glass-secondary rounded-pill px-4 py-2 text-white border-white border-opacity-10 text-decoration-none">
                        <i class="bi bi-arrow-left me-2"></i>Back to previous
                    </a>
                </div>

                <div class="glass-card shadow-2xl animate-fade-up overflow-hidden" style="border-radius: 40px; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1);">
                    <div class="p-4 p-md-5">
                        <form asp-action="Edit">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 mb-4 bg-danger bg-opacity-25 text-white"></div>
                            <input type="hidden" asp-for="Id" />

                            <div class="row g-4">
                                <!-- Name -->
                                <div class="col-12">
                                    <label asp-for="Name" class="form-label text-white-50 small text-uppercase fw-bold mb-2">Category Name</label>
                                    <input asp-for="Name" class="form-control glass-input" placeholder="e.g. Electronics, Fashion..." />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>

                                <!-- Photo URL -->
                                <div class="col-12">
                                    <label asp-for="Photo" class="form-label text-white-50 small text-uppercase fw-bold mb-2">Photo URL</label>
                                    <div class="input-group mb-3">
                                        <span class="input-group-text glass-input border-end-0"><i class="bi bi-image"></i></span>
                                        <input asp-for="Photo" class="form-control glass-input border-start-0" placeholder="https://example.com/image.jpg" />
                                    </div>
                                    <span asp-validation-for="Photo" class="text-danger small"></span>
                                    
                                    @if (!string.IsNullOrEmpty(Model.Photo))
                                    {
                                        <div class="mt-3 p-3 rounded-4 bg-white bg-opacity-5 border border-white border-opacity-10 d-flex align-items-center gap-3">
                                            <img src="@Model.Photo" class="rounded-3 shadow" style="width: 100px; height: 60px; object-fit: cover;" alt="Current">
                                            <div>
                                                <small class="text-white-50 d-block">Current Image Preview</small>
                                                <code class="text-primary small">Active Link</code>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Description -->
                                <div class="col-12">
                                    <label asp-for="Description" class="form-label text-white-50 small text-uppercase fw-bold mb-2">Description</label>
                                    <textarea asp-for="Description" rows="4" class="form-control glass-input" placeholder="What kind of products are in this category?"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-5">
                                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 flex-grow-1 shadow-lg border-0" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);">
                                    <i class="bi bi-cloud-check-fill me-2"></i>Save Category
                                </button>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-lg rounded-pill px-4 shadow-sm text-decoration-none">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-input {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: white !important;
        border-radius: 15px !important;
        padding: 12px 20px !important;
    }
    .glass-input:focus {
        background: rgba(255, 255, 255, 0.1) !important;
        border-color: #a78bfa !important;
        box-shadow: 0 0 0 4px rgba(167, 139, 250, 0.1) !important;
    }
    .btn-glass-secondary {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
    }
    .btn-glass-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up { animation: fadeInUp 0.6s ease forwards; }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
