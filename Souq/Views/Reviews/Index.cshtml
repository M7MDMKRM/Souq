@model IEnumerable<Souq.Models.Review>

@{
    ViewData["Title"] = "Customer Feedback - Marketo";
}

<div class="pt-5 pb-5" style="background: linear-gradient(135deg, #5b21b6 0%, #310d6b 100%);">
    <div class="container pt-5 mt-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="animate-fade-up">
            <h1 class="fw-bold text-white mb-1"><i class="bi bi-chat-quote me-2"></i>Customer Reviews</h1>
            <p class="text-white-50 mb-0">Manage and respond to feedback from your valued customers.</p>
        </div>
        <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 fw-bold animate-fade-up" style="color: #5b21b6;">
            <i class="bi bi-plus-lg me-2"></i>New Feedback
        </a>
    </div>
</div>

<div class="bg-theme-light py-5 min-vh-100">
    <div class="container">
        <div class="bg-white rounded-4 shadow-sm overflow-hidden animate-fade-up" style="border: 1px solid rgba(0,0,0,0.05);">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">Customer</th>
                            <th class="py-3 text-uppercase small fw-bold text-muted">Subject</th>
                            <th class="py-3 text-uppercase small fw-bold text-muted">Message</th>
                            <th class="pe-4 py-3 text-end text-uppercase small fw-bold text-muted">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle transition-hover">
                                <td class="ps-4 py-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                            @item.Name[0].ToString().ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.Name</div>
                                            <div class="small text-muted">@item.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4">
                                    <span class="badge rounded-pill bg-light text-dark px-3 py-2 border">@item.Subject</span>
                                </td>
                                <td class="py-4">
                                    <p class="mb-0 text-muted small" style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @item.Description
                                    </p>
                                </td>
                                <td class="pe-4 py-4 text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-circle p-2" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm rounded-circle p-2" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-circle p-2" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-chat-dots display-1 text-muted opacity-25"></i>
                    <h4 class="mt-4 fw-bold">No feedback yet</h4>
                    <p class="text-muted">Customer reviews will appear here once submitted.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: background-color 0.3s ease;
    }
    .transition-hover:hover {
        background-color: rgba(91, 33, 182, 0.02) !important;
    }
    .animate-fade-up {
        animation: fadeUp 0.6s ease-out forwards;
    }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
