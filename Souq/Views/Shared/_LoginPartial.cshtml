@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="d-flex align-items-center gap-3 list-unstyled mb-0 ms-3">
@if (SignInManager.IsSignedIn(User))
{
    <li>
        <a class="btn-admin" asp-controller="Dashboard" asp-action="Index" title="Dashboard">Dashboard</a>
    </li>
    <li>
        <form class="form-inline m-0 p-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn-admin border-0 bg-transparent text-white" style="cursor: pointer;">Logout</button>
        </form>
    </li>
}
else
{
    <li>
        <a class="btn-admin" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li>
        <a class="btn-admin" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
