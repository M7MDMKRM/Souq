@model Souq.Models.Order
@{
    ViewData["Title"] = $"Order #{Model.Id} - Marketo";
}

<div class="pt-5 pb-5" style="background: linear-gradient(135deg, #5b21b6 0%, #310d6b 100%);">
    <div class="container pt-5 mt-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="animate-fade-up">
                <h1 class="fw-bold text-white mb-1">Order #@Model.Id</h1>
                <p class="text-white-50 mb-0">Placed on @Model.OrderDate.ToString("MMMM dd, yyyy")</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 animate-fade-up">
                <i class="bi bi-arrow-left me-2"></i>Back to History
            </a>
        </div>
    </div>
</div>

<div class="bg-theme-light py-5 min-vh-100">
    <div class="container">
        <div class="row g-4">
            <!-- Order Items -->
            <div class="col-lg-8 animate-fade-up">
                <div class="bg-white rounded-4 shadow-sm p-4 p-md-5 mb-4">
                    <h5 class="fw-bold text-dark mb-4">Ordered Items</h5>
                    <div class="table-responsive">
                        <table class="table table-borderless">
                            <thead>
                                <tr class="text-muted small text-uppercase fw-bold border-bottom">
                                    <th class="ps-0">Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end pe-0">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr class="align-middle border-bottom border-light">
                                        <td class="ps-0 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.Product?.Photo" class="rounded-3 shadow-sm" style="width: 60px; height: 60px; object-fit: contain; background: #f8f9fa;">
                                                <span class="fw-bold text-dark">@item.Product?.Name</span>
                                            </div>
                                        </td>
                                        <td class="text-center py-3">@item.Quantity</td>
                                        <td class="text-end py-3 text-muted">EGP @item.Price</td>
                                        <td class="text-end py-3 pe-0 fw-bold text-dark">EGP @(item.Price * item.Quantity)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="mt-4 pt-4 border-top">
                        <div class="row justify-content-end">
                            <div class="col-md-5">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Subtotal</span>
                                    <span class="fw-bold">EGP @Model.TotalAmount</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Shipping</span>
                                    <span class="text-success fw-bold">FREE</span>
                                </div>
                                <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                                    <h5 class="fw-bold">Total Amount</h5>
                                    <h4 class="fw-bold" style="color: #5b21b6;">EGP @Model.TotalAmount</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Shipping Info -->
            <div class="col-lg-4 animate-fade-up" style="animation-delay: 0.1s;">
                <div class="bg-white rounded-4 shadow-sm p-4 mb-4 border-0">
                    <h5 class="fw-bold text-dark mb-4">Delivery Details</h5>
                    <div class="d-flex align-items-start gap-3 mb-4">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Shipping Address</h6>
                            <p class="text-muted small mb-0">@Model.FullName<br />@Model.Address, @Model.City</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 mb-4">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle p-2">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Contact Phone</h6>
                            <p class="text-muted small mb-0">@Model.Phone</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2">
                            <i class="bi bi-credit-card-fill"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Payment Method</h6>
                            <p class="text-muted small mb-0">@Model.PaymentMethod</p>
                        </div>
                    </div>
                </div>

                <!-- Order Status Card -->
                <div class="bg-white rounded-4 shadow-sm p-4 border-0" style="border-left: 5px solid #5b21b6 !important;">
                    <h6 class="fw-bold text-muted small text-uppercase mb-3">Order Status</h6>
                    <div class="d-flex align-items-center gap-3">
                        @{
                            var icon = Model.Status switch
                            {
                                "Pending" => "bi-clock-history text-warning",
                                "Shipped" => "bi-truck text-primary",
                                "Delivered" => "bi-check-circle-fill text-success",
                                "Cancelled" => "bi-x-circle-fill text-danger",
                                _ => "bi-info-circle text-secondary"
                            };
                        }
                        <i class="bi @icon fs-2"></i>
                        <div>
                            <h5 class="fw-bold mb-0">@Model.Status</h5>
                            <small class="text-muted">Your order is currently @Model.Status.ToLower().</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
