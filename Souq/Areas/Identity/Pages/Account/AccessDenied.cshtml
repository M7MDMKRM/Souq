@page
@model Souq.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center" style="background: radial-gradient(circle at top right, #5b21b6 0%, #1e1b4b 100%);">
    <div class="container text-center">
        <div class="glass-card animate-fade-up mx-auto p-5" style="max-width: 600px; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(20px); border-radius: 40px; border: 1px solid rgba(255, 255, 255, 0.1);">
            
            <div class="mb-4">
                <div class="d-inline-block p-4 rounded-circle mb-3" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2);">
                    <i class="bi bi-shield-lock-fill text-danger display-1"></i>
                </div>
            </div>

            <h1 class="display-4 fw-bold text-white mb-3">Access Denied</h1>
            <p class="text-white-50 fs-5 mb-5">
                Oops! It looks like you don't have the required permissions to access this area. 
                This section is reserved for administrators only.
            </p>

            <div class="d-flex gap-3 justify-content-center">
                <a href="/" class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-lg border-0" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);">
                    <i class="bi bi-house-door me-2"></i>Return Home
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-light rounded-pill px-4 py-3 fw-bold">
                    <i class="bi bi-arrow-left me-2"></i>Go Back
                </a>
            </div>
        </div>

        <p class="mt-5 text-white-50 small animate-fade-up" style="animation-delay: 0.2s;">
            &copy; @DateTime.Now.Year Marketo Marketplace Security System
        </p>
    </div>
</div>

<style>
    .glass-card {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    
    .animate-fade-up {
        animation: fadeUp 0.8s ease-out forwards;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
