@page
@model Souq.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="bg-theme-purple d-flex align-items-center justify-content-center pt-5 pb-5" style="min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8 animate-fade-up">
                <div class="bg-white p-5 rounded-5 shadow-lg">
                    <div class="text-center mb-5">
                        <div class="d-inline-block p-4 rounded-circle mb-4" style="background: rgba(99, 102, 241, 0.1);">
                            <i class="bi bi-shield-lock-fill display-4" style="color: var(--accent-color);"></i>
                        </div>
                        <h2 class="fw-bold text-dark">Welcome Back</h2>
                        <p class="text-muted">Login to your Marketo account</p>
                    </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-4" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-bold text-muted small">Email Address</label>
                            <input asp-for="Input.Email" class="form-control form-control-lg modern-input bg-light border-0" autocomplete="username" aria-required="true" placeholder="admin@souq.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-4">
                            <label asp-for="Input.Password" class="form-label fw-bold text-muted small">Password</label>
                            <input asp-for="Input.Password" class="form-control form-control-lg modern-input bg-light border-0" autocomplete="current-password" aria-required="true" placeholder="********" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label small text-muted" asp-for="Input.RememberMe">Remember me</label>
                            </div>
                            <a href="#" class="small text-decoration-none fw-bold" style="color: var(--accent-color);">Forgot?</a>
                        </div>
                        
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg text-white fw-bold py-3 rounded-4" style="background: var(--accent-color); transition: all 0.3s ease;">
                            Sign In <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                        
                        <div class="text-center mt-4">
                            <span class="text-muted small">New to Marketo?</span>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="small fw-bold text-decoration-none ms-2" style="color: var(--accent-color);">Create Account</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
